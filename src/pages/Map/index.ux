<template>
  <div class="page">
    <canvas
      id="mapCanvas"
      class="map"
      ontouchstart="onTouchStart"
      ontouchmove="onTouchMove"
      ontouchend="onTouchEnd"
      ontouchcancel="onTouchEnd"
    ></canvas>

    <!-- 区域名（点击切换） -->
    <text class="region-name" onclick="switchRegion">{{regionName}} ›</text>

    <!-- 缩放 / 定位 控制按钮 -->
    <div class="ctl ctl-zoom-in" onclick="zoomIn">
      <text class="ctl-txt">＋</text>
    </div>
    <div class="ctl ctl-zoom-out" onclick="zoomOut">
      <text class="ctl-txt">－</text>
    </div>
    <div class="ctl ctl-locate" onclick="locate">
      <text class="ctl-txt">⌖</text>
    </div>

    <!-- 提示信息（定位失败等） -->
    <text class="hint" if="{{hintVisible}}">{{hint}}</text>

    <!-- 运行诊断状态（持久显示，定位渲染问题用） -->
    <text class="debug">{{debug}}</text>
  </div>
</template>

<style>
  .page {
    position: relative;
    width: 390px;
    height: 450px;
    background-color: #0a0e14;
  }

  .map {
    width: 390px;
    height: 450px;
  }

  .region-name {
    position: absolute;
    top: 26px;
    left: 0;
    right: 0;
    color: #ffd166;
    font-size: 24px;
    text-align: center;
    padding: 6px 18px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 16px;
  }

  .ctl {
    position: absolute;
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.12);
    align-items: center;
    justify-content: center;
  }

  .ctl-txt {
    color: #ffffff;
    font-size: 30px;
    text-align: center;
  }

  .ctl-zoom-in {
    right: 12px;
    bottom: 168px;
  }

  .ctl-zoom-out {
    right: 12px;
    bottom: 104px;
  }

  .ctl-locate {
    right: 12px;
    bottom: 40px;
  }

  .hint {
    position: absolute;
    left: 60px;
    right: 60px;
    bottom: 30px;
    color: #ffd166;
    font-size: 22px;
    padding: 8px 16px;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0.55);
    text-align: center;
  }

  .debug {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 4px;
    color: #9aa7b3;
    font-size: 18px;
    text-align: center;
  }
</style>

<script>
  import geolocation from '@blueos.hardware.location.location'
  import mapData from './mapdata.js'

  const SIZE_W = 390
  const SIZE_H = 450
  const CX = SIZE_W / 2
  const CY = SIZE_H / 2
  const M_PER_DEG = 111320
  // 等效 Web 墨卡托 z 缩放 → px/m 比例（在当地纬度处）
  const PX_M_BASE = 156543.03392

  export default {
    data: {
      regionName: '',
      hint: '',
      hintVisible: false,
      debug: ''
    },

    onInit() {
      this.regionIdx = 0
      this.applyRegion()
      this.user = null
      this.touch = null
    },

    onReady() {
      // 页面创建完成，初始化相机参数（canvas 渲染延迟到 onShow）
      this.setupCamera()
    },

    onShow() {
      // 官方 canvas 示例在 onShow 中获取上下文并渲染
      // 这里加入诊断：定位 canvas 元素 / 上下文 / 绘制是否成功
      let dbg = ''
      const canvas = this.$element('mapCanvas')
      if (!canvas) {
        dbg = 'E1:canvas元素未找到'
      } else {
        try {
          const ctx = canvas.getContext('2d')
          if (!ctx) {
            dbg = 'E2:getContext为空'
          } else {
            this.ctx = ctx
            dbg = 'OK:' + (mapData.regions[this.regionIdx] ? mapData.regions[this.regionIdx].name : '?')
          }
        } catch (e) {
          dbg = 'E3:' + (e && e.message ? e.message : String(e))
        }
      }
      this.debug = dbg
      if (!this.camera) {
        this.setupCamera()
      }
      this.render()
      this.requestLocation()
    },

    // 切换区域：循环 北京 → 江苏 → 四川 → 北京
    switchRegion() {
      this.regionIdx = (this.regionIdx + 1) % mapData.regions.length
      this.user = null
      this.applyRegion()
      this.setupCamera()
      // 切换区域后重新获取 canvas 上下文
      const canvas = this.$element('mapCanvas')
      if (canvas) {
        this.ctx = canvas.getContext('2d')
      }
      this.render()
      this.requestLocation()
    },

    // 根据 regionIdx 计算投影参数与显示名
    applyRegion() {
      const reg = mapData.regions[this.regionIdx]
      const latRad = (reg.center[0] * Math.PI) / 180
      this.proj = {
        centerLat: reg.center[0],
        centerLng: reg.center[1],
        cosLat: Math.cos(latRad),
        mPerDegLng: M_PER_DEG * Math.cos(latRad)
      }
      this.regionName = reg.name
    },

    setupCamera() {
      const reg = mapData.regions[this.regionIdx]
      this.camera = {
        x: 0,
        y: 0,
        scale: Math.pow(2, reg.zoom) / (PX_M_BASE * this.proj.cosLat)
      }
      this.scaleMin = Math.pow(2, reg.minZoom) / (PX_M_BASE * this.proj.cosLat)
      this.scaleMax = Math.pow(2, reg.maxZoom) / (PX_M_BASE * this.proj.cosLat)
    },

    requestLocation() {
      const that = this
      if (!geolocation || !geolocation.getLocation) {
        that.showHint('当前系统不支持定位')
        return
      }
      geolocation.getLocation({
        success: function (res) {
          if (!res) return
          that.user = {
            lat: res.latitude,
            lng: res.longitude,
            accuracy: res.accuracy || 0
          }
          that.render()
        },
        fail: function (data, code) {
          if (code === 400) {
            that.showHint('未授权定位权限')
          } else {
            that.showHint('定位失败')
          }
        }
      })
    },

    showHint(text) {
      const that = this
      this.hint = text
      this.hintVisible = true
      if (this.hintTimer) clearTimeout(this.hintTimer)
      this.hintTimer = setTimeout(function () {
        that.hintVisible = false
      }, 2600)
    },

    // ---------- 坐标投影 ----------
    worldX(lng) {
      return (lng - this.proj.centerLng) * this.proj.mPerDegLng
    },

    worldY(lat) {
      return (this.proj.centerLat - lat) * M_PER_DEG
    },

    toScreen(wx, wy) {
      return [
        wx * this.camera.scale - this.camera.x + CX,
        wy * this.camera.scale - this.camera.y + CY
      ]
    },

    screenToWorld(sx, sy) {
      return [
        (sx - CX + this.camera.x) / this.camera.scale,
        (sy - CY + this.camera.y) / this.camera.scale
      ]
    },

    // 将线段裁剪到矩形可视区内（Liang-Barsky），返回 [x1,y1,x2,y2] 或 null
    // pad 为额外外扩的像素，用于道路描边外漏
    clipToBox(x1, y1, x2, y2, pad) {
      const xmin = -pad
      const ymin = -pad
      const xmax = SIZE_W + pad
      const ymax = SIZE_H + pad
      const dx = x2 - x1
      const dy = y2 - y1
      const p = [-dx, dx, -dy, dy]
      const q = [x1 - xmin, xmax - x1, y1 - ymin, ymax - y1]
      let t0 = 0
      let t1 = 1
      for (let i = 0; i < 4; i++) {
        if (p[i] === 0) {
          if (q[i] < 0) return null
        } else {
          const r = q[i] / p[i]
          if (p[i] < 0) {
            if (r > t1) return null
            if (r > t0) t0 = r
          } else {
            if (r < t0) return null
            if (r < t1) t1 = r
          }
        }
      }
      return [x1 + dx * t0, y1 + dy * t0, x1 + dx * t1, y1 + dy * t1]
    },

    // 判断点是否在矩形可视区内（inset > 0 外扩，inset < 0 内缩）
    inBox(x, y, inset) {
      return x >= -inset && x <= SIZE_W + inset && y >= -inset && y <= SIZE_H + inset
    },

    // ---------- 渲染 ----------
    render() {
      if (!this.ctx) return
      const ctx = this.ctx
      const reg = mapData.regions[this.regionIdx]

      ctx.fillStyle = '#0a0e14'
      ctx.fillRect(0, 0, SIZE_W, SIZE_H)
      ctx.fillStyle = '#10161d'
      ctx.fillRect(0, 0, SIZE_W, SIZE_H)

      // 诊断：画一条必然可见的亮黄对角线，验证 stroke 是否生效
      ctx.strokeStyle = '#ffff00'
      ctx.lineWidth = 6
      ctx.beginPath()
      ctx.moveTo(0, 0)
      ctx.lineTo(SIZE_W, SIZE_H)
      ctx.stroke()

      // 行政区边界（省级地图：地级市多边形）
      if (reg.regions && reg.regions.length > 0) {
        this.drawRegions(reg.regions)
      }

      // 水面（街道级地图）
      if (reg.waters && reg.waters.length > 0) {
        this.drawWaters(reg.waters)
      }

      // 道路 / 轨道（街道级地图）
      if (reg.roads && reg.roads.length > 0) {
        this.drawRoads(reg.roads)
      }

      // POI
      if (reg.pois && reg.pois.length > 0) {
        this.drawPois(reg.pois, reg)
      }

      // 用户定位
      if (this.user) {
        const s = this.toScreen(this.worldX(this.user.lng), this.worldY(this.user.lat))
        if (this.inBox(s[0], s[1], -4)) {
          if (this.user.accuracy > 0) {
            const rad = this.user.accuracy * this.camera.scale
            ctx.fillStyle = '#1d4d68'
            ctx.beginPath()
            ctx.arc(s[0], s[1], rad, 0, Math.PI * 2, true)
            ctx.fill()
          }
          ctx.fillStyle = '#ffffff'
          ctx.beginPath()
          ctx.arc(s[0], s[1], 7, 0, Math.PI * 2, true)
          ctx.fill()
          ctx.strokeStyle = '#4cc3ff'
          ctx.lineWidth = 4
          ctx.beginPath()
          ctx.arc(s[0], s[1], 7, 0, Math.PI * 2, true)
          ctx.stroke()
        }
      }

      // 比例尺（底部中央）
      this.drawScaleBar()

      // 边框
      ctx.strokeStyle = '#3a4149'
      ctx.lineWidth = 2
      ctx.strokeRect(0, 0, SIZE_W, SIZE_H)

      // 诊断统计：道路段数与覆盖范围
      const sc = this._segCount || 0
      let diag = '道路' + sc + '段'
      if (sc > 0) {
        diag += ' x=' + Math.round(this._minX) + '~' + Math.round(this._maxX) + ' y=' + Math.round(this._minY) + '~' + Math.round(this._maxY)
      }
      this.debug = diag
    },

    // 绘制行政区多边形：陆地填充 + 描边 + 城市名
    drawRegions(regions) {
      const ctx = this.ctx
      for (let i = 0; i < regions.length; i++) {
        const r = regions[i]
        if (!r.points || r.points.length < 3) continue
        const pts = []
        let minX = Infinity
        let maxX = -Infinity
        let minY = Infinity
        let maxY = -Infinity
        for (let j = 0; j < r.points.length; j++) {
          const s = this.toScreen(this.worldX(r.points[j][1]), this.worldY(r.points[j][0]))
          pts.push(s)
          if (s[0] < minX) minX = s[0]
          if (s[0] > maxX) maxX = s[0]
          if (s[1] < minY) minY = s[1]
          if (s[1] > maxY) maxY = s[1]
        }
        // 包围盒与可视区无交集则跳过
        if (maxX < 0 || minX > SIZE_W || maxY < 0 || minY > SIZE_H) continue
        ctx.fillStyle = '#1b2a22'
        ctx.strokeStyle = '#4a6b4a'
        ctx.lineWidth = 2
        ctx.beginPath()
        ctx.moveTo(pts[0][0], pts[0][1])
        for (let j = 1; j < pts.length; j++) ctx.lineTo(pts[j][0], pts[j][1])
        ctx.closePath()
        ctx.fill()
        ctx.stroke()
      }
    },

    drawWaters(waters) {
      const ctx = this.ctx
      for (let i = 0; i < waters.length; i++) {
        const w = waters[i]
        if (!w.points || w.points.length < 3) continue
        const pts = []
        let minX = Infinity
        let maxX = -Infinity
        let minY = Infinity
        let maxY = -Infinity
        for (let j = 0; j < w.points.length; j++) {
          const s = this.toScreen(this.worldX(w.points[j][1]), this.worldY(w.points[j][0]))
          pts.push(s)
          if (s[0] < minX) minX = s[0]
          if (s[0] > maxX) maxX = s[0]
          if (s[1] < minY) minY = s[1]
          if (s[1] > maxY) maxY = s[1]
        }
        if (maxX < 0 || minX > SIZE_W || maxY < 0 || minY > SIZE_H) continue
        ctx.fillStyle = '#1c3a52'
        ctx.strokeStyle = '#2a5a7d'
        ctx.lineWidth = 2
        ctx.beginPath()
        ctx.moveTo(pts[0][0], pts[0][1])
        for (let j = 1; j < pts.length; j++) ctx.lineTo(pts[j][0], pts[j][1])
        ctx.closePath()
        ctx.fill()
        ctx.stroke()
        const cx = pts.reduce(function (s, p) { return s + p[0] }, 0) / pts.length
        const cy = pts.reduce(function (s, p) { return s + p[1] }, 0) / pts.length
        ctx.fillStyle = '#7fb4d8'
        ctx.font = 'normal 20px'
        ctx.textAlign = 'center'
        ctx.textBaseline = 'middle'
        ctx.fillText(w.name, cx, cy)
      }
    },

    drawRoads(roads) {
      const ctx = this.ctx
      const styles = {
        highway: { width: 5, color: '#f0b64a' },
        street: { width: 3, color: '#e8e8e8' },
        rail: { width: 2.5, color: '#9aa0a8' }
      }
      for (let i = 0; i < roads.length; i++) {
        const road = roads[i]
        const st = styles[road.type] || styles.street
        ctx.strokeStyle = st.color
        ctx.lineWidth = st.width
        ctx.lineCap = 'round'
        for (let j = 0; j < road.points.length - 1; j++) {
          const a = this.toScreen(this.worldX(road.points[j][1]), this.worldY(road.points[j][0]))
          const b = this.toScreen(this.worldX(road.points[j + 1][1]), this.worldY(road.points[j + 1][0]))
          const seg = this.clipToBox(a[0], a[1], b[0], b[1], 0)
          if (!seg) continue
          this._segCount = (this._segCount || 0) + 1
          this._minX = this._minX === undefined ? seg[0] : Math.min(this._minX, seg[0])
          this._maxX = this._maxX === undefined ? seg[0] : Math.max(this._maxX, seg[0])
          this._minY = this._minY === undefined ? seg[1] : Math.min(this._minY, seg[1])
          this._maxY = this._maxY === undefined ? seg[1] : Math.max(this._maxY, seg[1])
          ctx.beginPath()
          ctx.moveTo(seg[0], seg[1])
          ctx.lineTo(seg[2], seg[3])
          if (road.type === 'rail') {
            this.strokeDashed(seg[0], seg[1], seg[2], seg[3], 12, 8)
          } else {
            ctx.stroke()
          }
        }
      }
    },

    drawPois(pois, reg) {
      const ctx = this.ctx
      const isProvince = reg.regions && reg.regions.length > 0
      for (let i = 0; i < pois.length; i++) {
        const poi = pois[i]
        const s = this.toScreen(this.worldX(poi.lng), this.worldY(poi.lat))
        if (!this.inBox(s[0], s[1], -14)) continue
        // 省级：城市名直接显示；街道级：圆点+名称
        if (isProvince) {
          ctx.fillStyle = '#ffd166'
          ctx.beginPath()
          ctx.arc(s[0], s[1], 3, 0, Math.PI * 2, true)
          ctx.fill()
          ctx.fillStyle = '#eef2f7'
          ctx.font = 'normal 18px'
          ctx.textAlign = 'center'
          ctx.textBaseline = 'top'
          ctx.fillText(poi.name, s[0], s[1] + 6)
        } else {
          ctx.fillStyle = '#ffb35c'
          ctx.beginPath()
          ctx.arc(s[0], s[1], 4, 0, Math.PI * 2, true)
          ctx.fill()
          ctx.fillStyle = '#eef2f7'
          ctx.font = 'normal 20px'
          ctx.textAlign = 'left'
          ctx.textBaseline = 'top'
          ctx.fillText(poi.name, s[0] + 8, s[1] - 12)
        }
      }
    },

    // 沿线段绘制虚线（Canvas 未提供 setLineDash）
    strokeDashed(x1, y1, x2, y2, dashLen, gapLen) {
      const ctx = this.ctx
      const dx = x2 - x1
      const dy = y2 - y1
      const len = Math.sqrt(dx * dx + dy * dy)
      if (len <= 0) return
      let drawn = 0
      let on = true
      while (drawn < len) {
        const step = Math.min(on ? dashLen : gapLen, len - drawn)
        const fx = dx / len
        const fy = dy / len
        if (on) {
          ctx.beginPath()
          ctx.moveTo(x1 + fx * drawn, y1 + fy * drawn)
          ctx.lineTo(x1 + fx * (drawn + step), y1 + fy * (drawn + step))
          ctx.stroke()
        }
        drawn += step
        on = !on
      }
    },

    drawScaleBar() {
      const ctx = this.ctx
      // 扩展比例尺候选，覆盖省级（km 级）到街道级（m 级）
      const candidates = [50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000, 50000, 100000, 200000]
      let meters = candidates[0]
      for (let i = 0; i < candidates.length; i++) {
        const px = candidates[i] * this.camera.scale
        if (px >= 46 && px <= 120) {
          meters = candidates[i]
          break
        }
        meters = candidates[i]
      }
      const px = meters * this.camera.scale
      const y = SIZE_H - 22
      const x2 = SIZE_W - 16
      const x1 = x2 - px
      ctx.strokeStyle = '#c9d1da'
      ctx.lineWidth = 3
      ctx.beginPath()
      ctx.moveTo(x1, y)
      ctx.lineTo(x2, y)
      ctx.stroke()
      ctx.beginPath()
      ctx.moveTo(x1, y - 6)
      ctx.lineTo(x1, y + 6)
      ctx.moveTo(x2, y - 6)
      ctx.lineTo(x2, y + 6)
      ctx.stroke()
      ctx.fillStyle = '#e6ebf1'
      ctx.font = 'normal 18px'
      ctx.textAlign = 'center'
      ctx.textBaseline = 'bottom'
      const label = meters >= 1000 ? (meters / 1000) + 'km' : meters + 'm'
      ctx.fillText(label, (x1 + x2) / 2, y - 8)
    },

    // ---------- 手势 ----------
    onTouchStart(e) {
      if (!e.touches || e.touches.length < 1) return
      const t0 = e.touches[0]
      const state = {
        x: t0.clientX,
        y: t0.clientY,
        camX: this.camera.x,
        camY: this.camera.y,
        scale0: this.camera.scale
      }
      if (e.touches.length >= 2) {
        const t1 = e.touches[1]
        state.two = true
        state.x2 = t1.clientX
        state.y2 = t1.clientY
        state.dist0 = Math.sqrt(
          (t0.clientX - t1.clientX) * (t0.clientX - t1.clientX) +
          (t0.clientY - t1.clientY) * (t0.clientY - t1.clientY)
        )
      }
      this.touch = state
    },

    onTouchMove(e) {
      if (!this.touch || !e.touches || e.touches.length < 1) return
      const state = this.touch
      const t0 = e.touches[0]

      if (e.touches.length >= 2) {
        const t1 = e.touches[1]
        if (!state.two) {
          // 第二根手指在移动过程中加入：以当前为双指起点
          state.two = true
          state.scale0 = this.camera.scale
          state.dist0 = Math.sqrt(
            (t0.clientX - t1.clientX) * (t0.clientX - t1.clientX) +
            (t0.clientY - t1.clientY) * (t0.clientY - t1.clientY)
          )
          return
        }
        const dist = Math.sqrt(
          (t0.clientX - t1.clientX) * (t0.clientX - t1.clientX) +
          (t0.clientY - t1.clientY) * (t0.clientY - t1.clientY)
        )
        if (dist <= 0 || state.dist0 <= 0) return
        // 双指缩放：保持双指中点下的地理位置不动
        const midX = (t0.clientX + t1.clientX) / 2
        const midY = (t0.clientY + t1.clientY) / 2
        const w = this.screenToWorld(midX, midY)
        let scale = state.scale0 * (dist / state.dist0)
        scale = Math.max(this.scaleMin, Math.min(this.scaleMax, scale))
        this.camera.scale = scale
        this.camera.x = w[0] * scale + CX - midX
        this.camera.y = w[1] * scale + CY - midY
      } else if (e.touches.length === 1) {
        // 单指平移
        const dx = t0.clientX - state.x
        const dy = t0.clientY - state.y
        this.camera.x -= dx
        this.camera.y -= dy
        state.x = t0.clientX
        state.y = t0.clientY
      }
      this.render()
    },

    onTouchEnd() {
      this.touch = null
    },

    // ---------- 按钮 ----------
    zoomIn() {
      this.zoomBy(1.3)
    },

    zoomOut() {
      this.zoomBy(1 / 1.3)
    },

    zoomBy(factor) {
      // 以屏幕中心为锚点缩放
      const w = this.screenToWorld(CX, CY)
      let scale = this.camera.scale * factor
      scale = Math.max(this.scaleMin, Math.min(this.scaleMax, scale))
      this.camera.scale = scale
      this.camera.x = w[0] * scale
      this.camera.y = w[1] * scale
      this.render()
    },

    locate() {
      const that = this
      // 已有定位则回到定位点
      if (this.user) {
        this.camera.x = this.worldX(this.user.lng) * this.camera.scale
        this.camera.y = this.worldY(this.user.lat) * this.camera.scale
        this.render()
        return
      }
      this.requestLocation()
    }
  }
</script>
